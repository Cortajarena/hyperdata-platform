# Copy to `.env` (gitignored) and adjust. Compose files fall back to these
# same dev defaults inline, so the stack boots even without a .env — this file
# is the authoritative list of credentials/secrets the stack needs.
#
# NEVER commit a real (non-dev) password here or anywhere tracked.

# --- postgres (airflow metadata) ---
HYPERDATA_PG_USER=airflow
HYPERDATA_PG_PASSWORD=airflow
POSTGRES_DB=airflow

# --- clickhouse serving (platform/clickhouse) ---
CLICKHOUSE_USER=hyperdata
CLICKHOUSE_PASSWORD=hyperdata-dev

# --- minio warehouse storage (services/compose.yaml) ---
MINIO_ROOT_USER=hyperdata
MINIO_ROOT_PASSWORD=hyperdata-dev

# --- real secrets (unset in defaults; live in .env / CI secrets / Secret Mgr) ---
# HYPERLIQUID_API_KEY=
# GCP_SA_KEY=
