# Copy to `.env` (gitignored) and adjust. Compose files fall back to these
# same dev defaults inline, so the stack boots even without a .env — this file
# is the authoritative list of credentials/secrets the stack needs.
#
# NEVER commit a real (non-dev) password here or anywhere tracked.

# --- postgres (airflow metadata) ---
HYPERDATA_PG_USER=airflow
HYPERDATA_PG_PASSWORD=airflow
POSTGRES_DB=airflow

# --- clickhouse serving (platform/clickhouse) ---
CLICKHOUSE_USER=hyperdata
CLICKHOUSE_PASSWORD=hyperdata-dev

# --- minio warehouse storage (services/compose.yaml) ---
MINIO_ROOT_USER=hyperdata
MINIO_ROOT_PASSWORD=hyperdata-dev

# --- hypercore ingestion (indexer service + the ingest DAG's env) ---
# Warehouse coordinates, shared by the indexer and the Airflow DAG that runs it.
HYPERCORE_CATALOG_URI=http://iceberg-catalog:19120
HYPERCORE_WAREHOUSE=s3://hyperdata-warehouse
HYPERCORE_S3_ENDPOINT=http://minio:9000
# Which stream a run ingests: raw_book_diffs | order_statuses | fills
HYPERCORE_TABLE=fills
# Where the node writes its output. The real node bind-mounts
# ${DATA_DIR}/hl-node-data -> /home/hluser/hl, so this is that subtree; it must
# agree with the indexer's NODE_DIR or no files are found.
HYPERCORE_NODE_DIR=/data/hl-node-data/data
# Host paths the DAG passes to `docker run` (resolved on the host, not in the
# Airflow container).
HYPERCORE_INDEXER_IMAGE=hyperdata-indexer:latest
HYPERCORE_SCHEMAS_DIR=/workspaces/hyperdata-platform/platform/schemas/generated/arrow
HYPERCORE_INDEXER_CONTEXT=/workspaces/hyperdata-platform/services/hyperdata-indexer-hypercore

# --- real secrets (unset in defaults; live in .env / CI secrets / Secret Mgr) ---
# HYPERLIQUID_API_KEY=
# GCP_SA_KEY=
