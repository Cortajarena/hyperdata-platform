{
  "workbench.colorTheme": "Monokai",
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.rulers": [
    100
  ],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 95,
  "diffEditor.renderSideBySide": false,
  "git.detectSubmodulesLimit": 20,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
  }
}